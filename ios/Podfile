# Podfile for Nunba Companion iOS app.
# Pinned to React Native 0.81.4 — must match ../package.json.

require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '15.1'
prepare_react_native_project!

# Use static frameworks for stable Swift interop with Objective-C++ deps.
use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true

target 'NunbaCompanion' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'NunbaCompanionTests' do
    inherit! :complete
    # XCTest target picks up the same pods so we can import the host
    # app's Swift modules directly in tests.
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # Force iOS 15.1 (RN 0.81 floor) on every pod target — silences
    # warnings from older transitive pods that still ship 12.0/13.0
    # default targets, and guarantees ReactAppDependencyProvider
    # codegen pod resolves cleanly.
    #
    # Also force RCT_DEV=0 across React Native pods so the #if RCT_DEV
    # blocks (RCTBundleURLProvider.setDefaults setting enableDev=YES,
    # the dev menu, the "Connect to Metro" placeholder, the packager
    # probe) are eliminated at preprocess time. CI runs with no
    # Metro; runtime overrides via NSUserDefaults are racy and the
    # volatile domain RN writes from setDefaults wins. Compile-time
    # is the only reliable fix.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'

        # glog vendors an older fmt whose FMT_COMPILE_STRING format-string
        # checks are compile-time `consteval` calls; Xcode 26.6's stricter
        # C++20 Clang rejects them ("not a constant expression"). fmt's own
        # base.h defines FMT_CONSTEVAL from the __cpp_consteval feature
        # macro (gated on C++20), overriding any command-line -D, so the
        # only real fix is compiling this target below C++20 so consteval
        # is never in play.
        if target.name == 'fmt'
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'gnu++17'
        end

        if target.name.start_with?('React') ||
           target.name == 'RCTRequired' ||
           target.name == 'RCTTypeSafety' ||
           target.name.start_with?('FBReact')
          existing = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
          existing = [existing] if existing.is_a?(String)
          existing << 'RCT_DEV=0'
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = existing
        end
      end
    end
  end
end
